# HTTPS host served by Caddy. On the VM, set this to the VM's private IP or
# to an internal DNS name. Local Docker development uses localhost.
INCOME_BOOK_HOST=localhost

# Optional loopback-only HTTP port for local health checks and debugging.
# It is never exposed to other computers; employees use HTTPS on port 443.
INCOME_BOOK_PORT=8000

# Host directory with private client YAML files. It is mounted read-only into
# the container and is deliberately not included in the Docker image.
INCOME_BOOK_CLIENTS_HOST_DIR=./private_data/clients

IMAGE_TAG=local
