# Network interface on which the FastAPI container is published.
# Keep 127.0.0.1 for local use or when the reverse proxy runs on this host.
# Set the VM private IP when an external reverse proxy needs direct access.
INCOME_BOOK_BIND_ADDRESS=127.0.0.1

# HTTP port exposed by the FastAPI container.
INCOME_BOOK_PORT=8000

# Host used only by the optional internal-https Caddy profile.
INCOME_BOOK_HOST=localhost

# Host directory with private client YAML files. It is mounted read-only into
# the container and is deliberately not included in the Docker image.
INCOME_BOOK_CLIENTS_HOST_DIR=./private_data/clients

# Docker image tag used by Compose.
IMAGE_TAG=local
